# Copy this file to .env.local and fill in the values.
# Both values come from Supabase: Project Settings → API Keys.
# They are public (visible in the browser), so they are safe in Vercel's settings.

# Project URL, e.g. https://abcdefgh.supabase.co (without /rest/v1)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key, starts with sb_publishable_
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (starts with sb_secret_): Supabase → Project Settings → API Keys.
# Server only: lets the app create student accounts and handle invite links.
# Never share it, never commit it, never use it in browser code.
SUPABASE_SECRET_KEY=

# Optional: test teacher account for browser tests (npm run test:e2e)
E2E_TEACHER_EMAIL=
E2E_TEACHER_PASSWORD=

# Optional: test student account for browser tests
E2E_STUDENT_EMAIL=
E2E_STUDENT_PASSWORD=
