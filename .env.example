# Copy this file to .env.local and fill in the values.
# Both values come from Supabase: Project Settings → API Keys.
# They are public (visible in the browser), so they are safe in Vercel's settings.

# Project URL, e.g. https://abcdefgh.supabase.co (without /rest/v1)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key, starts with sb_publishable_
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (starts with sb_secret_): Supabase → Project Settings → API Keys.
# Server only: lets the app create student accounts and handle invite links.
# Never share it, never commit it, never use it in browser code.
SUPABASE_SECRET_KEY=

# Optional: test teacher account for browser tests (npm run test:e2e)
E2E_TEACHER_EMAIL=
E2E_TEACHER_PASSWORD=

# Optional: test student account for browser tests
E2E_STUDENT_EMAIL=
E2E_STUDENT_PASSWORD=

# Optional: contact email for the free translation service MyMemory (words
# selected in lessons). With it the daily limit is about 10 times higher.
# Not a secret, but personal: keep it in .env.local / Vercel, not in the code.
MYMEMORY_EMAIL=

# Translation of selected words by AI (Google Gemini, free tier): a key from
# aistudio.google.com → Get API key. Without it the free MyMemory is used.
GEMINI_API_KEY=
# Optional: another Gemini model (default gemini-3.1-flash-lite).
GEMINI_MODEL=

# Course loader (scripts/content): the teacher account that owns library courses.
CONTENT_OWNER_ID=
