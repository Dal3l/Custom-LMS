# Copy this file to .env.local and fill in the values.
# Both values come from Supabase: Project Settings → API Keys.
# They are public (visible in the browser), so they are safe in Vercel's settings.

# Project URL, e.g. https://abcdefgh.supabase.co (without /rest/v1)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key, starts with sb_publishable_
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Never put the secret / service_role key here or in client code.
